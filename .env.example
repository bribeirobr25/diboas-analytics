# diBoaS Analytics - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env to version control

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# FRED (Federal Reserve Economic Data) - Get free key at fred.stlouisfed.org
FRED_API_KEY=your_fred_key_here

# =============================================================================
# RECOMMENDED API KEYS (Higher rate limits)
# =============================================================================

# CoinGecko - Get free Demo key at coingecko.com/api
COINGECKO_API_KEY=your_coingecko_key_here

# =============================================================================
# WALLET TRACKING (Week 3-4)
# =============================================================================

# Etherscan - Get free key at etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_key_here

# Helius (Solana) - Get free key at helius.dev
HELIUS_API_KEY=your_helius_key_here

# =============================================================================
# ALERTS & NOTIFICATIONS (Week 4)
# =============================================================================

# Slack Webhook for analytics alerts
SLACK_ANALYTICS_WEBHOOK=your_slack_webhook_here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Override default directories
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
